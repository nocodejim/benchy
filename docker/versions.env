# Single source of truth for every pinned version in the benchy images.
# `./bench build` passes each KEY=VALUE here to docker build as --build-arg.
# Bump a version -> update its sha256 -> `./bench build` -> `./bench selftest`.

# Base images (pinned by digest)
UBUNTU_IMAGE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
NODE_IMAGE=node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
