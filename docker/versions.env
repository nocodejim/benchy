# Agent harnesses (npm)
COPILOT_CLI_VERSION=1.0.88
CLAUDE_CODE_VERSION=2.1.281

# Grader-only (npm)
DIFF2HTML_CLI_VERSION=5.2.15

# Static binaries (linux/amd64) with sha256 of the downloaded artifact
