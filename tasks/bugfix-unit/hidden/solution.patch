+class TokenCase(unittest.TestCase):
+    def setUp(self):
+        self.app = create_app(TestConfig)
+        self.app_context = self.app.app_context()
+        self.app_context.push()
+        db.create_all()
+
+    def tearDown(self):
+        db.session.remove()
+        db.drop_all()
+        self.app_context.pop()
+
+    def test_token_reuse_and_revoke(self):
+        u = User(username='john', email='john@example.com')
+        db.session.add(u)
+        db.session.commit()
+        token = u.get_token()
+        db.session.commit()
+        self.assertEqual(u.get_token(), token)
+        self.assertEqual(User.check_token(token), u)
+        u.revoke_token()
+        db.session.commit()
+        self.assertIsNone(User.check_token(token))
+        self.assertNotEqual(u.get_token(), token)
+
+
 if __name__ == '__main__':
     unittest.main(verbosity=2)
