+# --- build stage: resolve and install dependencies into a virtualenv ---------
+FROM docker.io/library/python:3.12-slim-bookworm AS build
+WORKDIR /build
+RUN python -m venv /opt/venv
+ENV PATH=/opt/venv/bin:$PATH
+COPY requirements.txt .
+RUN pip install --no-cache-dir -r requirements.txt \
+ && pip install --no-cache-dir pymysql==1.1.1 cryptography==44.0.0
 
+# --- runtime stage: no compilers, no pip cache, non-root ---------------------
+FROM docker.io/library/python:3.12-slim-bookworm
+RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin microblog
+WORKDIR /home/microblog
+COPY --from=build /opt/venv /opt/venv
+ENV PATH=/opt/venv/bin:$PATH \
+    FLASK_APP=microblog.py \
+    PYTHONDONTWRITEBYTECODE=1 \
+    PYTHONUNBUFFERED=1
 COPY app app
 COPY migrations migrations
