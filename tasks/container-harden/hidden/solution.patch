diff --git a/compose.yaml b/compose.yaml
new file mode 100644
index 0000000..c1daebd
--- /dev/null
+++ b/compose.yaml
@@ -0,0 +1,34 @@
+# Local stack for Docker Desktop or Podman (`podman compose`).
+# Secrets come from a local .env file (see .env.example); never commit .env.
+services:
+  web:
+    build: .
+    image: localhost/microblog:dev
+    ports:
+      - "8000:5000"
+    environment:
+      DATABASE_URL: "postgresql://microblog:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@db:5432/microblog"
+      SECRET_KEY: "${SECRET_KEY:?set SECRET_KEY in .env}"
+      LOG_TO_STDOUT: "1"
+    depends_on:
+      db:
+        condition: service_healthy
+    restart: unless-stopped
+
+  db:
+    image: docker.io/library/postgres:17-alpine
+    environment:
+      POSTGRES_DB: microblog
+      POSTGRES_USER: microblog
+      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}"
+    volumes:
+      - db-data:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U microblog -d microblog"]
+      interval: 5s
+      timeout: 3s
+      retries: 10
+    restart: unless-stopped
+
+volumes:
+  db-data: {}
