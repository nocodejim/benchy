+  name: {{ include "microblog.fullname" . }}
+  labels:
+    {{- include "microblog.labels" . | nindent 4 }}
+spec:
+  type: ClusterIP
+  selector:
+    {{- include "microblog.selectorLabels" . | nindent 4 }}
+  ports:
+    - name: http
+      port: {{ .Values.service.port }}
+      targetPort: http
diff --git a/deploy/helm/microblog/values.yaml b/deploy/helm/microblog/values.yaml
new file mode 100644
index 0000000..86c3258
--- /dev/null
+++ b/deploy/helm/microblog/values.yaml
@@ -0,0 +1,25 @@
+replicaCount: 2
+
+image:
+  repository: ghcr.io/example/microblog
+  tag: ""          # defaults to the chart appVersion
+  pullPolicy: IfNotPresent
+
+# Existing Secret (created outside this chart) with keys DATABASE_URL and SECRET_KEY.
+existingSecret: microblog-secrets
+
+service:
+  port: 80
+
+ingress:
+  enabled: true
+  className: nginx
+  host: microblog.example.com
+
+resources:
+  requests:
+    cpu: 100m
+    memory: 256Mi
+  limits:
+    cpu: 500m
+    memory: 512Mi
