diff --git a/deploy/fleet.yaml b/deploy/fleet.yaml
new file mode 100644
index 0000000..73b2b0e
--- /dev/null
+++ b/deploy/fleet.yaml
@@ -0,0 +1,24 @@
+# Rancher Fleet bundle: deploys the chart to clusters labelled env=staging / env=production.
+defaultNamespace: microblog
+helm:
+  chart: ./helm/microblog
+  releaseName: microblog
+targetCustomizations:
+  - name: staging
+    clusterSelector:
+      matchLabels:
+        env: staging
+    helm:
+      values:
+        replicaCount: 2
+        ingress:
+          host: microblog.staging.example.com
+  - name: production
+    clusterSelector:
+      matchLabels:
+        env: production
+    helm:
+      values:
+        replicaCount: 3
+        ingress:
+          host: microblog.example.com
