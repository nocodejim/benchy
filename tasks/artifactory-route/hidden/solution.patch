diff --git a/.github/workflows/image.yml b/.github/workflows/image.yml
new file mode 100644
index 0000000..cf61509
--- /dev/null
+++ b/.github/workflows/image.yml
@@ -0,0 +1,32 @@
+name: Image
+
+on:
+  push:
+    branches: [main]
+
+permissions:
+  contents: read
+
+jobs:
+  image:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
+      - name: Log in to Artifactory
+        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
+        with:
+          registry: artifactory.example.com
+          username: ${{ secrets.ARTIFACTORY_USER }}
+          password: ${{ secrets.ARTIFACTORY_TOKEN }}
+      - name: Build and push
+        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
+        with:
+          context: .
+          push: true
+          tags: artifactory.example.com/docker-local/microblog:${{ github.sha }}
+          secrets: |
+            pip_index_url=https://${{ secrets.ARTIFACTORY_USER }}:${{ secrets.ARTIFACTORY_TOKEN }}@artifactory.example.com/artifactory/api/pypi/pypi-virtual/simple
diff --git a/Dockerfile b/Dockerfile
index 972b18b..f95650b 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,15 +1,21 @@
-FROM python:slim
+# syntax=docker/dockerfile:1
+# All downloads go through Artifactory: base image via the docker-remote repo,
+# Python packages via the pypi-virtual repo. Credentials arrive as a BuildKit
+# secret at build time only; they never land in an image layer or build arg.
+FROM artifactory.example.com/docker-remote/library/python:3.12-slim-bookworm
 
+WORKDIR /home/microblog
 COPY requirements.txt requirements.txt
-RUN pip install -r requirements.txt
-RUN pip install gunicorn pymysql cryptography
+RUN --mount=type=secret,id=pip_index_url,env=PIP_INDEX_URL \
+    pip install --no-cache-dir -r requirements.txt \
+ && pip install --no-cache-dir pymysql==1.1.1 cryptography==44.0.0
 
 COPY app app
 COPY migrations migrations
 COPY microblog.py config.py boot.sh ./
 RUN chmod a+x boot.sh
 
-ENV FLASK_APP microblog.py
+ENV FLASK_APP=microblog.py
 RUN flask translate compile
 
 EXPOSE 5000
